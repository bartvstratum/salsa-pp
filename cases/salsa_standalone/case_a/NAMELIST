&salsa
   ! Case A: the settings of the old SALSA-standalone test (driver.f90 and its mo_submctl.f90, commit 41da7aa),
   ! mapped onto the master &salsa namelist. Anything not set here is a master default.
   ! The initial aerosol comes from the input file (&driver), not from nA/dpgA/sigmagA.

   ! Processes: condensation and size distribution update only (old: nlcoag, nlauto, nlactiv = .FALSE.).
   lscoag%switch   = .FALSE.
   lscnd%switch    = .TRUE.
   lsauto%switch   = .FALSE.
   lsactiv%switch  = .FALSE.
   lscndgas        = .TRUE.    ! As old nlcndgas; H2SO4 and organic vapours are zero.
   lscndh2oae      = .TRUE.
   lscndh2ocl      = .TRUE.
   lsdistupdate    = .TRUE.
   lsfreeRH%switch = .TRUE.    ! The old driver does not limit RH.

   ! Aerosol bins as in the old test.
   reglim = 3.e-9, 5.e-8, 7.e-7, 1.e-5
   nbin   = 3, 7

   ! The old rain bins (limits 50, 55, 65, 100, 200, 500, 1000, 2000 um) are not geometric, and master only
   ! supports geometric layouts: 7 bins over the same range, volume ratio 40**(3/7).
   bloPrc%nbins     = 7
   bloPrc%dlo       = 50.e-6
   bloPrc%vol_ratio = 4.859562

   ! Compounds of the old test; H2O is always active.
   nspec_dry = 3
   listspec  = 'SO4','NO','NH','','','',''
/

&driver
   case_name   = 'A'
   input_file  = 'input.nc'
   output_file = 'output_fortran.nc'
   dt          = 1.
   nsteps      = 400
   w           = 0.2   ! Vertical velocity (m s-1), as in the old driver.
/
